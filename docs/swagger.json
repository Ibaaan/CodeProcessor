{
    "swagger": "2.0",
    "info": {
        "title": "CodeProcessor API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/result/{task_id}": {
            "get": {
                "description": "Returns 200 while processing; result is empty until ready.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Get task result",
                "operationId": "getTaskResult",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Task UUID",
                        "name": "task_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Status and result",
                        "schema": {
                            "$ref": "#/definitions/server.resultResponse"
                        }
                    },
                    "400": {
                        "description": "wrong id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "couldn't find task",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal error (empty JSON string)",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/status/{task_id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Get task status",
                "operationId": "getTaskStatus",
                "parameters": [
                    {
                        "type": "string",
                        "format": "uuid",
                        "description": "Task UUID",
                        "name": "task_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "in_progress or ready",
                        "schema": {
                            "$ref": "#/definitions/server.statusResponse"
                        }
                    },
                    "400": {
                        "description": "wrong id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "couldn't find task",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal error (empty JSON string)",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/task": {
            "post": {
                "description": "Requires non-empty code and translator. Returns a 36-character UUIDv7.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tasks"
                ],
                "summary": "Create a task",
                "operationId": "createTask",
                "parameters": [
                    {
                        "description": "Code and translator (both required)",
                        "name": "task",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.CodeRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Task ID (UUIDv7)",
                        "schema": {
                            "$ref": "#/definitions/server.taskResponse"
                        }
                    },
                    "400": {
                        "description": "Invalid body or task creation failed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal error (empty JSON string)",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.CodeRequest": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "translator": {
                    "type": "string"
                }
            }
        },
        "server.resultResponse": {
            "type": "object",
            "properties": {
                "result": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "server.statusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        },
        "server.taskResponse": {
            "type": "object",
            "properties": {
                "task_id": {
                    "type": "string"
                }
            }
        }
    }
}